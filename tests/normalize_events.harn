import { init, shutdown } from "../src/lib"
import { circleci_normalize, fixture_raw } from "./helpers"

type NormalizeCase = {name: string, header: string, kind: string, status: string, is_failure: bool}

pipeline test_normalize_events(harness: Harness) {
  const secret = "test-webhook-secret"
  shutdown(harness)
  init(harness, {signing_secret: secret})
  const cases: list<NormalizeCase> = [
    {
      name: "workflow_completed_success",
      header: "workflow-completed",
      kind: "workflow-completed",
      status: "success",
      is_failure: false,
    },
    {
      name: "workflow_completed_failed",
      header: "workflow-completed",
      kind: "workflow-completed",
      status: "failed",
      is_failure: true,
    },
    {
      name: "job_completed_failed",
      header: "job-completed",
      kind: "job-completed",
      status: "failed",
      is_failure: true,
    },
  ]
  for {name, header, kind, status, is_failure} in cases {
    const normalized = circleci_normalize(harness, fixture_raw(harness.fs, name, secret, header))
    assert_eq(normalized.type, "event", name + " envelope type")
    assert_eq(normalized.event.kind, kind, name + " kind")
    assert_eq(normalized.event.signature_status.state, "verified", name + " verified")
    assert_eq(normalized.event.payload.provider, "circleci", name + " provider")
    assert_eq(normalized.event.payload.status, status, name + " status")
    assert_eq(normalized.event.payload.is_failure, is_failure, name + " is_failure")
    assert_eq(normalized.event.payload.project_slug, "github/acme/widgets", name + " project slug")
    assert_eq(normalized.event.payload.repo, "https://github.com/acme/widgets", name + " repo")
    assert(normalized.event.payload.raw != nil, name + " includes raw payload")
    assert(
      normalized.event.dedupe_key != "" && normalized.event.dedupe_key != nil,
      name + " dedupe key",
    )
  }
  shutdown(harness)
}
