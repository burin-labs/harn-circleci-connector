import { call } from "../src/lib"

@complexity(allow)
pipeline test_call_smoke(harness: Harness) {
  harness.net.egress_policy({allow: ["circleci-api.test"], default: "deny"})
  harness.testing.http_mock_clear()
  const base = "https://circleci-api.test/api/v2"
  const token = "circle-token-xyz"
  const workflow_id = "wf-bbbbbbbb-0000-1111-2222-333333333333"
  // workflow.rerun (from_failed default true).
  harness.testing.http_mock(
    "POST",
    base + "/workflow/" + workflow_id + "/rerun",
    {status: 202, body: "{\"workflow_id\":\"" + workflow_id + "\"}"},
  )
  const rerun = call(
    harness,
    "workflow.rerun",
    {api_base_url: base, api_token: token, workflow_id: workflow_id},
  )
  assert_eq(rerun.workflow_id, workflow_id, "rerun returns workflow id")
  // workflow.cancel.
  harness.testing.http_mock(
    "POST",
    base + "/workflow/" + workflow_id + "/cancel",
    {status: 202, body: "{\"message\":\"Accepted.\"}"},
  )
  const cancel = call(
    harness,
    "workflow.cancel",
    {api_base_url: base, api_token: token, workflow_id: workflow_id},
  )
  assert_eq(cancel.message, "Accepted.", "cancel accepted")
  // workflow.get.
  harness.testing.http_mock(
    "GET",
    base + "/workflow/" + workflow_id,
    {status: 200, body: "{\"id\":\"" + workflow_id + "\",\"status\":\"failed\"}"},
  )
  const wf = call(
    harness,
    "workflow.get",
    {api_base_url: base, api_token: token, workflow_id: workflow_id},
  )
  assert_eq(wf.status, "failed", "workflow get status")
  // workflow.jobs with pagination token.
  harness.testing.http_mock(
    "GET",
    base + "/workflow/" + workflow_id + "/job?page-token=abc",
    {
      status: 200,
      body: "{\"items\":[{\"name\":\"test\",\"status\":\"failed\"}],\"next_page_token\":null}",
    },
  )
  const jobs = call(
    harness,
    "workflow.jobs",
    {api_base_url: base, api_token: token, page_token: "abc", workflow_id: workflow_id},
  )
  assert_eq(jobs.items[0].name, "test", "workflow jobs item name")
  // job.get by project slug + job number.
  harness.testing.http_mock(
    "GET",
    base + "/project/github/acme/widgets/job/128",
    {status: 200, body: "{\"number\":128,\"name\":\"test\"}"},
  )
  const job = call(
    harness,
    "job.get",
    {api_base_url: base, api_token: token, job_number: 128, project_slug: "github/acme/widgets"},
  )
  assert_eq(job.number, 128, "job get number")
  // artifacts.list.
  harness.testing.http_mock(
    "GET",
    base + "/project/github/acme/widgets/128/artifacts",
    {
      status: 200,
      body: "{\"items\":[{\"path\":\"test-results.xml\",\"url\":\"https://artifacts.test/1\"}]}",
    },
  )
  const artifacts = call(
    harness,
    "artifacts.list",
    {api_base_url: base, api_token: token, job_number: 128, project_slug: "github/acme/widgets"},
  )
  assert_eq(artifacts.items[0].path, "test-results.xml", "artifacts path")
  // api.request escape hatch.
  harness.testing.http_mock("GET", base + "/me", {status: 200, body: "{\"login\":\"octocat\"}"})
  const me = call(
    harness,
    "api.request",
    {api_base_url: base, api_token: token, method: "GET", path: "/me"},
  )
  assert_eq(me.login, "octocat", "api.request me login")
  // Missing token is rejected.
  const missing_token = call(
    harness,
    "workflow.get",
    {api_base_url: base, workflow_id: workflow_id},
  )
  assert(is_err(missing_token), "missing token rejects")
  assert_eq(unwrap_err(missing_token).code, "missing_token", "missing token code")
  // Unsupported method is rejected.
  const unsupported = call(harness, "workflow.frobnicate", {api_base_url: base, api_token: token})
  assert(is_err(unsupported), "unsupported method rejected")
  assert_eq(unwrap_err(unsupported).code, "method_not_found", "unsupported method code")
  // Private/loopback hosts are blocked by egress validation.
  const blocked = call(
    harness,
    "workflow.get",
    {api_base_url: "https://127.0.0.1/api/v2", api_token: token, workflow_id: workflow_id},
  )
  assert(is_err(blocked), "loopback host blocked")
  assert_eq(unwrap_err(blocked).code, "invalid_api_base_url", "loopback host code")
  harness.testing.http_mock_clear()
}
