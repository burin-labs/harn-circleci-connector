import {
  activate,
  call,
  init,
  kinds,
  methods,
  normalize_inbound,
  payload_schema,
  provider_id,
  shutdown,
} from "../src/lib"

/** Build a `circleci-signature` header value for a raw body + secret. */
pub fn sign_body(secret, body) {
  return "v1=" + hmac_sha256(to_string(secret), body)
}

/** Build inbound webhook headers, signing the body with the given secret. */
pub fn circleci_headers(secret, body, event_type) {
  return {
    "circleci-event-type": event_type,
    "circleci-signature": sign_body(secret, body),
    "content-type": "application/json",
  }
}

/** Read a fixture JSON body from the test fixtures directory. */
pub fn fixture_body(harness: Harness, name) {
  return harness.fs.read_text(harness.fs.source_dir() + "/fixtures/webhooks/" + name + ".json")
}

/** Build a signed raw inbound envelope from a named fixture. */
pub fn fixture_raw(harness: Harness, name, secret, event_type, extra = nil) {
  const body = fixture_body(harness, name)
  return (extra ?? {}) + {body_text: body, headers: circleci_headers(secret, body, event_type)}
}

pub fn assert_circleci_interface(harness: Harness) {
  shutdown(harness)
  assert_eq(provider_id(), "circleci", "provider id")
  assert_eq(kinds()[0], "webhook", "webhook kind")
  assert_eq(payload_schema().harn_schema_name, "CircleCIEventPayload", "payload schema name")
  let rerun_requires_approval = nil
  let get_requires_approval = nil
  for entry in methods() {
    if entry.name == "workflow.rerun" {
      rerun_requires_approval = entry.requires_approval
    }
    if entry.name == "workflow.get" {
      get_requires_approval = entry.requires_approval
    }
  }
  assert_eq(rerun_requires_approval, true, "workflow.rerun requires approval")
  assert_eq(get_requires_approval, false, "workflow.get does not require approval")
  const initialized = init(harness, {signing_secret: "test-secret"})
  assert(initialized.initialized, "init stores state")
  const activated = activate(
    harness,
    [{id: "primary", path: "/circleci/events", secrets: {signing_secret: "test-secret"}}],
  )
  assert_eq(activated.bindings, 1, "activate counts bindings")
}

pub fn circleci_call(harness: Harness, method, args) {
  return call(harness, method, args)
}

pub fn circleci_normalize(harness: Harness, raw) {
  return normalize_inbound(harness, raw)
}
