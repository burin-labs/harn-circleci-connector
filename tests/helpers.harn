import {
  activate,
  call,
  init,
  kinds,
  methods,
  normalize_inbound,
  payload_schema,
  provider_id,
  shutdown,
} from "../src/lib"

/** Build a `circleci-signature` header value for a raw body + secret. */
pub fn sign_body(secret: string, body: string) {
  return "v1=" + hmac_sha256(to_string(secret), body)
}

/** Build inbound webhook headers, signing the body with the given secret. */
pub fn circleci_headers(secret: string, body: string, event_type: string) {
  return {
    "circleci-event-type": event_type,
    "circleci-signature": sign_body(secret, body),
    "content-type": "application/json",
  }
}

/** Read a fixture JSON body from the test fixtures directory. */
pub fn fixture_body(fs: HarnessFs, name: string) {
  return fs.read_text(fs.source_dir() + "/fixtures/webhooks/" + name + ".json")
}

/** Build a signed raw inbound envelope from a named fixture. */
pub fn fixture_raw(
  fs: HarnessFs,
  name: string,
  secret: string,
  event_type: string,
  extra: dict? = nil,
) {
  const body = fixture_body(fs, name)
  return (extra ?? {}) + {body_text: body, headers: circleci_headers(secret, body, event_type)}
}

pub fn assert_circleci_interface(harness: Harness) {
  shutdown(harness)
  expect_eq(provider_id(), "circleci", "provider id")
  expect_eq(kinds()[0], "webhook", "webhook kind")
  expect_eq(payload_schema().harn_schema_name, "CircleCIEventPayload", "payload schema name")
  let rerun_requires_approval = nil
  let get_requires_approval = nil
  for entry in methods() {
    if entry.name == "workflow.rerun" {
      rerun_requires_approval = entry.requires_approval
    }
    if entry.name == "workflow.get" {
      get_requires_approval = entry.requires_approval
    }
  }
  expect_eq(rerun_requires_approval, true, "workflow.rerun requires approval")
  expect_eq(get_requires_approval, false, "workflow.get does not require approval")
  const initialized = init(harness, {signing_secret: "test-secret"})
  expect(initialized.initialized, "init stores state")
  const activated = activate(
    harness,
    [{id: "primary", path: "/circleci/events", secrets: {signing_secret: "test-secret"}}],
  )
  expect_eq(activated.bindings, 1, "activate counts bindings")
}

pub fn circleci_call(harness: Harness, method: string, args: dict?) {
  return call(harness, method, args ?? {})
}

pub fn circleci_normalize(harness: Harness, raw: dict) {
  return normalize_inbound(harness, raw)
}

/**
 * Require that a smoke-test condition holds. Helper `fn`s are not test
 * pipelines, so `assert` does not belong here (HARN-LNT-025).
 */
fn expect(condition: unknown, message: string = "expectation failed") {
  require condition, message
}

/** Require that two smoke-test values are equal, reporting both on failure. */
fn expect_eq(actual: unknown, expected: unknown, message: string = "values differ") {
  require actual == expected,
    message + ": expected " + to_string(expected) + ", got "
    + to_string(actual)
}
